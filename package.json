{
  "name": "@nodecfdi/cfdi-to-pdf",
  "type": "module",
  "version": "3.0.0-2",
  "packageManager": "pnpm@12.21.0",
  "description": "Librería para crear un pdf basado en un XML CFDI o Retenciones",
  "author": "Fernando Isidro <luffynando@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/nodecfdi/cfdi-to-pdf",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodecfdi/cfdi-to-pdf.git"
  },
  "bugs": {
    "url": "https://github.com/nodecfdi/cfdi-to-pdf/issues"
  },
  "keywords": [
    "cfdi",
    "retenciones",
    "xml",
    "pdf",
    "sat"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      }
    },
    "./types": {
      "import": {
        "types": "./build/src/types.d.ts",
        "default": "./build/src/types.js"
      }
    },
    "./node": {
      "import": {
        "types": "./build/src/builders/node/index.d.ts",
        "default": "./build/src/builders/node/index.js"
      }
    },
    "./browser": {
      "import": {
        "types": "./build/src/builders/browser/index.d.ts",
        "default": "./build/src/builders/browser/index.js"
      }
    },
    "./templates": {
      "import": {
        "types": "./build/templates/index.d.ts",
        "default": "./build/templates/index.js"
      }
    }
  },
  "module": "./build/index.js",
  "types": "./build/index.d.ts",
  "files": [
    "build"
  ],
  "engines": {
    "node": "^22.22.2 || ^24 || ^26"
  },
  "scripts": {
    "prepare": "is-in-ci || husky",
    "changelog": "auto-changelog -u -p",
    "commitlint": "commitlint --edit",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "tool:code": "pnpm run lint:check && pnpm run typecheck",
    "tool:build": "pnpm run tool:code && pnpm run test:run",
    "build": "tsdown",
    "release": "release-it"
  },
  "peerDependencies": {
    "@nodecfdi/cfdi-core": ">=0.6.2",
    "@types/pdfmake": ">=0.2.10",
    "pdfmake": ">=0.2.17"
  },
  "peerDependenciesMeta": {
    "@types/pdfmake": {
      "optional": true
    }
  },
  "dependencies": {
    "@nodecfdi/cfdi-expresiones": "^3.0.4",
    "@nodecfdi/sat-micro-catalogs": "^1.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eienjs/eslint-config": "^2.3.2",
    "@nodecfdi/cfdi-core": "^0.6.2",
    "@types/node": "^26.6.6",
    "@types/pdfmake": "0.2.11",
    "@vitest/coverage-istanbul": "^5.1.1",
    "auto-changelog": "^2.7.0",
    "eslint": "^10.15.0",
    "eslint-plugin-erasable-syntax-only": "^0.7.2",
    "husky": "^9.1.7",
    "is-in-ci": "^2.0.0",
    "pdfmake": "^0.2.23",
    "release-it": "^21.1.2",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ],
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "auto-changelog": {
    "template": "keepachangelog",
    "hideCredit": true,
    "commitLimit": false
  },
  "release-it": {
    "git": {
      "commit": true,
      "tag": true,
      "push": true,
      "requireCleanWorkingDir": true,
      "commitMessage": "chore(release): :tada: v${version}",
      "tagAnnotation": "chore(release): :tada: v${version}"
    },
    "github": {
      "release": true,
      "web": true,
      "releaseName": "Release v${version}"
    },
    "npm": {
      "publish": true,
      "publishPackageManager": "pnpm",
      "publishArgs": [
        "--no-git-checks"
      ]
    },
    "hooks": {
      "before:init": [
        "pnpm run lint:check",
        "pnpm run typecheck",
        "pnpm test:run"
      ],
      "after:bump": [
        "pnpm run build",
        "pnpm run changelog"
      ]
    }
  }
}
